# This definition intentionally pins the provider release. Updating multiACE
# requires a reviewed firmware change with a new version and checksum.
PKG_LABEL="multiACE"
PKG_VERSION="1.00.1b"
PKG_URL="https://github.com/Tareku99/multiACE/releases/download/multiace-v1.00.1b/multiace-paxx-1.00.1b.tar.gz"
PKG_SHA256="eba7514cff6dfbbecb0990bc083138ee07400fd71af4ca7e706c25c2bac34536"
PKG_APP_DIR="/oem/apps/multiace"
PKG_PREFIX="multiace"

# The archive is a Python/configuration package rather than a single binary.
# Validate the files that the PAXX activation hook needs before extended-pkg
# moves the staging directory into the active application tree.
pkg_post_install() {
    local staging="$1"
    local required
    for required in \
        klipper/extras/ace.py \
        klipper/extras/ace_protocol.py \
        klipper/extras/filament_feed_ace.py \
        klipper/kinematics/extruder_ace.py \
        config/extended/ace.cfg \
        config/extended/multiace/ace_vars.cfg \
        web/backend/main.py \
        web/backend/requirements.txt \
        web/frontend/index.html; do
        if [[ ! -f "$staging/$required" ]]; then
            echo "multiACE package is missing $required" >&2
            return 1
        fi
    done

    # The web head is optional at build time but required when ACE is enabled.
    # Install its constrained Python dependencies into lava's persistent user
    # site rather than modifying the firmware image or the package payload.
    if HOME=/home/lava /usr/bin/python3 -c 'import fastapi, uvicorn, httpx, pydantic, websockets, multipart, serial' 2>/dev/null; then
        return 0
    fi
    if [[ ! -x /usr/bin/python3 ]] || ! /usr/bin/python3 -m pip --version >/dev/null 2>&1; then
        echo "multiACE web dependencies are unavailable (python3/pip missing)" >&2
        return 1
    fi

    echo "Installing constrained multiACE web dependencies..."
    mkdir -p /home/lava/.local
    if command -v runuser >/dev/null 2>&1; then
        runuser -u lava -- env HOME=/home/lava \
            /usr/bin/python3 -m pip install --user --no-input \
            -r "$staging/web/backend/requirements.txt"
    elif command -v su >/dev/null 2>&1; then
        su -s /bin/sh lava -c \
            "HOME=/home/lava /usr/bin/python3 -m pip install --user --no-input -r '$staging/web/backend/requirements.txt'"
    else
        HOME=/home/lava /usr/bin/python3 -m pip install --user --no-input \
            -r "$staging/web/backend/requirements.txt"
    fi
    chown -R lava:lava /home/lava/.local 2>/dev/null || true
    HOME=/home/lava /usr/bin/python3 -c 'import fastapi, uvicorn, httpx, pydantic, websockets, multipart, serial'
}
