# Keep text files normalized and checked out with Linux line endings.
* text=auto eol=lf

# Opaque firmware, package, library, and image assets must stay binary.
*.bin binary
*.img binary
*.so binary
*.a binary
*.o binary
*.elf binary
*.bmp binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.zip binary
*.gz binary
*.xz binary
*.tar binary
*.whl binary
*.pyc binary
*.pyo binary
